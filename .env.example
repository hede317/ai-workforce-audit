# ===== HedeYou AI Workforce 环境配置 =====
# 复制为 .env 后修改。数据库建议用 docker-compose 拉起（postgres:16 + pgvector）

# --- 服务 ---
AWF_HOST=0.0.0.0
AWF_PORT=8600

# --- 数据库（PostgreSQL 16+，pgvector 就绪）---
DATABASE_URL=postgres://ai_workforce:ai_workforce@127.0.0.1:5434/ai_workforce

# --- 认证 ---
AWF_JWT_SECRET=请改成32位以上随机串（生产必改，弱密钥拒绝启动）
# 开发环境逃生阀：AWF_ALLOW_INSECURE=1（仅本机开发用）
# docker-compose 还需要：AWF_PG_PASSWORD / N8N_BASIC_AUTH_USER / N8N_BASIC_AUTH_PASSWORD / N8N_ENCRYPTION_KEY
AWF_ADMIN_USERNAME=admin
AWF_ADMIN_PASSWORD=首次启动用，改密码后重启不会覆盖

# --- AI 模型网关（OpenAI 兼容 /chat/completions 协议，可指向 one-api/GLM/OpenAI 等）---
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 示例（复用本机 one-api）：AI_BASE_URL=http://127.0.0.1:3100/v1

# --- 视频出片（可选：复用 AIOS worker 的 MoneyPrinterTurbo 线）---
MPT_WORKER_URL=

# --- n8n 执行层（可选：确定性工作流转发）---
N8N_BASE_URL=
N8N_WEBHOOK_TOKEN=

# --- 媒体目录 ---
AWF_MEDIA_DIR=./data/media

# --- Embedding 服务（可选，OpenAI 兼容 /embeddings；配置后记忆检索升级为向量语义检索，未配置回落关键词检索）---
EMBED_API_BASE=
EMBED_API_KEY=
EMBED_MODEL=

# --- SMTP 邮件（可选；email.send_draft 工具需审批后才会真实发送）---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURITY=ssl


# --- 国内/海外自动发布（social-auto-upload 桥）---
# 打开后 publish.auto / publish.auto_many 才可用；不配则这两个工具返回 503 诚实态
FEATURE_AUTOPUBLISH=0
# social-auto-upload 仓库根目录（含 sau_cli.py 与 uploader/）
SAU_DIR=/Users/hedeyou/Documents/deepseek-harness/分发工具-social-auto-upload
# 该仓库的 venv python 绝对路径（必须已装 playwright）
SAU_PYTHON=/Users/hedeyou/Documents/deepseek-harness/分发工具-social-auto-upload/.venv/bin/python
# 默认发布账号名（对应 cookies/<platform>_<account>.json）
SAU_DEFAULT_ACCOUNT=creator
# 单次发布子进程超时（秒）。6 平台串行 + 上传耗时，建议 ≥900
SAU_TIMEOUT_SECS=900
# 海外平台（YouTube/TikTok）代理；国内平台不受影响
SAU_OVERSEAS_PROXY=http://127.0.0.1:7897
